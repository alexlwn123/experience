#!/usr/bin/env node
// A stand-in for fsite 0.6 in QA runs: the same commands and JSON shapes, backed by
// local bare repos under $HACKQA_STATE. Every call is logged to calls.log.
import { execFileSync } from "node:child_process";
import { appendFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { randomBytes } from "node:crypto";

const STATE = process.env.HACKQA_STATE;
const AGENT_NPUB = "npub1agentagentagentagentagentagentagentagentagentagentqa";
const KNOWN = { "alexlwn@finite.vip": "npub198kxhz0qyey9a3ufukkkz8swdqx4huf3lcn2tz3kwkt5ytne9ezskfayjc" };
const TAKEN = (process.env.HACKQA_TAKEN || "").split(",").filter(Boolean);
const args = process.argv.slice(2);
appendFileSync(join(STATE, "calls.log"), `${new Date().toISOString()} fsite ${args.join(" ")}\n`);

const flag = (name) => { const i = args.indexOf(name); return i >= 0 ? args[i + 1] : undefined; };
const flags = (name) => args.flatMap((a, i) => (a === name ? [args[i + 1]] : []));
const has = (name) => args.includes(name);
const out = (value, code = 0) => { console.log(JSON.stringify(value, null, 2)); process.exit(code); };
const fail = (code, message) => out({ error: { code, message } }, 1);
const projectPath = (slug) => join(STATE, "projects", `${slug}.json`);
const remote = (slug) => join(STATE, "remotes", `${slug}.git`);
const load = (slug) => existsSync(projectPath(slug)) ? JSON.parse(readFileSync(projectPath(slug), "utf8")) : null;
const save = (p) => writeFileSync(projectPath(p.slug), JSON.stringify(p, null, 2));
const resolve = (nip05) => KNOWN[nip05] || fail("nip05_not_found", `no NIP-05 name ${nip05}`);

// Email principals: invites and logins "send" a one-time token to $HACKQA_STATE/mail/<email>.txt;
// redeem marks the email verified (in verified.json) so auth git --email works.
const mailbox = (email) => join(STATE, "mail", `${email}.txt`);
const tokensPath = join(STATE, "tokens.json");
const verifiedPath = join(STATE, "verified.json");
const readJson = (path, fallback) => (existsSync(path) ? JSON.parse(readFileSync(path, "utf8")) : fallback);
function sendToken(email, intro) {
  const token = randomBytes(4).toString("hex").toUpperCase();
  writeFileSync(tokensPath, JSON.stringify({ ...readJson(tokensPath, {}), [email]: token }));
  mkdirSync(join(STATE, "mail"), { recursive: true });
  appendFileSync(mailbox(email), `\n--- email from Finite Sites, ${new Date().toISOString()} ---\n${intro}\n\n` +
    `Run this command to verify ${email}:\n\n  fsite auth redeem ${email} ${token}\n\nThe token works once and expires in 15 minutes. If it expires, run: fsite auth login ${email}\n`);
}

function versions(slug, path) {
  try {
    const count = execFileSync("git", ["--git-dir", remote(slug), "rev-list", "--count", "main", "--", path], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] });
    return Number(count.trim());
  } catch { return 0; }
}

function status(p) {
  const active = versions(p.slug, p.path);
  return {
    project_id: `proj_${p.slug}`, slug: p.slug, project_visibility: "private",
    git_remote_url: `file://${remote(p.slug)}`, role: "owner",
    site: { name: p.slug, url: `https://${p.slug}.finite.site/`, site_id: `site_${p.slug}`,
      status: active ? "published" : "pending", visibility: p.visibility, active_version: active,
      branch: "main", path: p.path, spa: false, created: false, requesting_user_shared: true },
    collaborators: p.collaborators,
  };
}

const [group, verb, target] = args;
if (group === "--version") { console.log("fsite 0.6.0"); process.exit(0); }
if (group === "describe") { console.log("machine-readable description: see the finite-sites-publishing-finite skill."); process.exit(0); }
if (group === "auth" && verb === "register") out({ registered: false, npub: AGENT_NPUB });
if (group === "auth" && verb === "status") out({ exists: true, npub: AGENT_NPUB });
if (group === "auth" && verb === "login") {
  sendToken(target, "Your Finite Sites sign-in code.");
  console.log(`A verification token was sent to ${target}.`);
  process.exit(0);
}
if (group === "auth" && verb === "redeem") {
  const token = args[3];
  const tokens = readJson(tokensPath, {});
  if (!token || tokens[target] !== token) fail("invalid_token", "the token is wrong, used, or expired: run fsite auth login EMAIL for a fresh one");
  delete tokens[target];
  writeFileSync(tokensPath, JSON.stringify(tokens));
  writeFileSync(verifiedPath, JSON.stringify([...new Set([...readJson(verifiedPath, []), target])]));
  out({ email: target, verified: true, linked_native: has("--link-native") });
}
if (group === "auth" && verb === "git") {
  const p = load(target) || fail("project_not_found", `no project ${target}`);
  const email = flag("--email");
  if (email && !readJson(verifiedPath, []).includes(email)) fail("email_not_verified", `${email} is not verified on this machine: fsite auth login ${email}, then fsite auth redeem ${email} TOKEN`);
  if (email && !p.collaborators.some((c) => c.email === email)) fail("forbidden", `${email} is not a collaborator on ${p.slug}`);
  out({ project: p.slug, git_remote_url: `file://${remote(p.slug)}`, stored: has("--store") });
}
if (group === "project" && verb === "init") {
  const config = flag("--config") || fail("usage", "--config is required");
  if (!existsSync(config)) fail("config_not_found", `${config} does not exist`);
  const toml = readFileSync(config, "utf8");
  const slug = toml.match(/^\s*slug\s*=\s*"([^"]+)"/m)?.[1] || fail("invalid_config", "project.slug is required");
  if (!/^[a-z0-9][a-z0-9-]{1,62}$/.test(slug)) fail("invalid_slug", `${slug} is not a lowercase DNS label`);
  const path = toml.match(/^\s*path\s*=\s*"([^"]+)"/m)?.[1] || "site";
  if (TAKEN.includes(slug)) fail("slug_taken", `the project slug ${slug} is already taken`);
  const existing = load(slug);
  if (has("--dry-run")) out({ dry_run: true, project: { slug, created: !existing }, site: { name: slug, path } });
  if (!existing) {
    mkdirSync(join(STATE, "projects"), { recursive: true });
    execFileSync("git", ["init", "-q", "--bare", "-b", "main", remote(slug)]);
    save({ slug, path, visibility: "private", collaborators: [{ npub: AGENT_NPUB, role: "owner", email: "" }], shares: [] });
  }
  out({ ...status(load(slug)), created: !existing });
}
if (group === "project" && verb === "grant") {
  const p = load(target) || fail("project_not_found", `no project ${target}`);
  const npub = flag("--npub") || (flag("--nip05") && resolve(flag("--nip05"))) || (flag("--email") && `email:${flag("--email")}`);
  if (!npub) fail("usage", "one of --email, --nip05, --npub is required");
  if (!p.collaborators.some((c) => c.npub === npub)) p.collaborators.push({ npub, role: flag("--role") || "editor", email: flag("--email") || "" });
  save(p);
  if (flag("--email") && has("--send-invite")) sendToken(flag("--email"), `You have been invited to collaborate on ${p.slug} as ${flag("--role") || "editor"}.`);
  out({ project: p.slug, granted: { npub, role: flag("--role") || "editor" } });
}
if (group === "project" && verb === "share") {
  const p = load(target) || fail("project_not_found", `no project ${target}`);
  if (has("--public") && !has("--yes-public")) fail("confirmation_required", "public sharing needs --yes-public");
  if (has("--public")) p.visibility = "public";
  if (has("--private")) p.visibility = "private";
  if (has("--shared")) p.visibility = "shared";
  const emails = [...new Set([...(p.emails || []), ...flags("--add-email")])];
  const npubs = [...new Set([...(p.shares || []), ...flags("--add-nip05").map(resolve), ...flags("--add-npub")])];
  save({ ...p, emails, shares: npubs });
  out({ project_slug: p.slug, site_name: p.slug, site_url: `https://${p.slug}.finite.site/`, visibility: p.visibility,
    shared_emails: emails, shared_npubs: npubs, invited_emails: has("--send-invite") ? flags("--add-email") : [] });
}
if (group === "project" && verb === "status") out(status(load(target) || fail("project_not_found", `no project ${target}`)));
if (group === "project" && verb === "list") {
  const { readdirSync } = await import("node:fs");
  const dir = join(STATE, "projects");
  const all = existsSync(dir) ? readdirSync(dir).map((f) => status(load(f.replace(/\.json$/, "")))) : [];
  // HACKQA_AS=alex lists what Alex's key sees: the projects he was granted, as an editor.
  const asAlex = process.env.HACKQA_AS === "alex";
  out({ projects: asAlex ? all.filter((p) => p.collaborators.some((c) => c.npub === KNOWN["alexlwn@finite.vip"])).map((p) => ({ ...p, role: "editor" })) : all });
}
if (group === "view") {
  const slug = String(target).replace(/^https?:\/\//, "").split(".")[0];
  out(status(load(slug) || fail("site_not_found", `no site ${target}`)).site);
}
fail("usage", `fsite: unknown command: ${args.join(" ")}`);
